# ──────────────────────────────────────────────────────────────────────────────
# NeuroRift × OpenClaw — Environment Variables
#
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# The .env file is automatically loaded by Docker Compose.
# ──────────────────────────────────────────────────────────────────────────────


# ─── Ollama / AI ──────────────────────────────────────────────────────────────
# Primary model for security operations
OLLAMA_MAIN_MODEL=llama3

# Secondary model for the AI assistant chat
OLLAMA_ASSISTANT_MODEL=llama3

# Enable/disable AI features
AI_ENABLED=true


# ─── External AI API Keys (optional) ─────────────────────────────────────────
# Leave blank to use Ollama (local LLM) only.
# These are passed as environment variables into the neurorift container.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# ─── Logging ──────────────────────────────────────────────────────────────────
# Python bridge log level: debug | info | warning | error
LOG_LEVEL=info

# Rust core log level: trace | debug | info | warn | error
RUST_LOG=info


# ─── Web UI ───────────────────────────────────────────────────────────────────
# Host port that the Next.js UI is exposed on
WEB_UI_PORT=3000


# ─── Service URLs (internal Docker networking — do NOT change unless custom) ──
# These are automatically wired in docker-compose.yml using service names.
# Only override if you are running services outside of Docker Compose.
#
# OLLAMA_HOST=http://ollama:11434
# NEURORIFT_BRIDGE_URL=http://neurorift:8766
# OPENCLAW_WS_URL=http://openclaw:8765
# NEURORIFT_WS_ADDR=0.0.0.0:8765
